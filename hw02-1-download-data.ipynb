    "#Downloading Data\n",
    "import subprocess\n",
    "from pathlib import Path\n",
    "data_dir = Path(\"data\")\n",
    "data_dir.mkdir(exist_ok=True)\n",
    "subprocess.run([\"aws\", \"s3\", \"cp\", \"s3://dsan6000-wikipedia/hourly_parquet/\", str(data_dir), \"--recursive\"], check=True)\n",
    "sorted(data_dir.glob(\"*.parquet\"))"
   ]
  }
